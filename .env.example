# SightFix AI Configuration
# Copy this file to .env and fill in your values

# === AI Model Configuration ===
# OpenAI-compatible API base URL
# For Ollama local: http://localhost:11434/v1
# For other providers: use their OpenAI-compatible endpoint
SIGHTFIX_API_BASE=http://localhost:11434/v1

# API key (use "ollama" for local Ollama, or your provider's key)
SIGHTFIX_API_KEY=ollama

# Vision model name
# Default: qwen2.5-vl:7b (Ollama) or Qwen/Qwen2.5-VL-7B-Instruct (hosted)
SIGHTFIX_MODEL=qwen2.5-vl:7b

# === Optional Settings ===
# Request timeout in seconds (default: 120)
SIGHTFIX_TIMEOUT=120

# Maximum image dimension for resizing before sending to API (default: 1280)
SIGHTFIX_MAX_IMAGE_DIM=1280

# Enable saving screenshots to disk (default: false)
SIGHTFIX_SAVE_SCREENSHOTS=false

# Directory for saved screenshots (default: ./screenshots)
SIGHTFIX_SCREENSHOT_DIR=./screenshots
